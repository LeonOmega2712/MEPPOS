# ============================================
# DATABASE
# ============================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Session pooler URL — used by the app at runtime (and Prisma Client)
# Production: use Supabase session pooler (host: aws-0-*.pooler.supabase.com, port 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meppos_db"

# Direct connection URL — used by Prisma CLI (migrate deploy, db seed)
# Production: use Supabase direct connection (host: db.*.supabase.co, port 5432)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/meppos_db"

# ============================================
# SERVER
# ============================================
PORT=3000
NODE_ENV=development

# Number of reverse-proxy hops in front of the app (used for req.ip and rate
# limiting). Leave at 0 locally. In Koyeb, set to 1 — trusting a hop that
# doesn't exist would let anyone spoof X-Forwarded-For and bypass rate limits.
TRUST_PROXY_HOPS=0

# ============================================
# CORS
# ============================================
# Frontend URL (Angular in development)
FRONTEND_URL=http://localhost:4200

# ============================================
# AUTHENTICATION
# ============================================
# JWT secrets — REQUIRED unless NODE_ENV=development (dev has an insecure fallback)
JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret

# Default admin password used by prisma/seed.ts — REQUIRED, no fallback.
# Minimum 12 characters. The seed refuses to run if this is unset.
ADMIN_DEFAULT_PASSWORD=

# ============================================
# INSTRUCTIONS
# ============================================
# 1. Copy this file as .env
# 2. Adjust values according to your setup
# 3. DO NOT commit the .env file (already in .gitignore)
# 4. Unless NODE_ENV=development, JWT secrets MUST be set (app will refuse to start without them)